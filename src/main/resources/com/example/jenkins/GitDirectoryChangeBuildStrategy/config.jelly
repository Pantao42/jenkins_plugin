<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry title="Verzeichnis-Regexe" description="Reguläre Ausdrücke für Verzeichnisse (eine pro Zeile)">
        <f:textarea field="directoryRegexes" />
    </f:entry>
    
    <f:entry title="GitHub API URL" description="GitHub API URL (Standard: https://api.github.com)">
        <f:textbox field="githubApiUrl" default="https://api.github.com" />
    </f:entry>
    
    <f:entry title="Credentials ID" description="GitHub Token Credentials ID (optional, verwendet sonst die Credentials der GitHub-Quelle)">
        <c:select field="credentialsId" />
    </f:entry>
    
    <f:entry title="Build-Einstellungen">
        <f:checkbox field="buildOnBranchChange" title="Bei Branch-Änderungen bauen" />
        <f:checkbox field="buildOnPullRequestChange" title="Bei Pull Request-Änderungen bauen" />
    </f:entry>
</j:jelly>

